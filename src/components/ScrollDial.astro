---
const sections = [
  { id: 'top', label: 'Top' },
  { id: 'work', label: 'Selected work' },
  { id: 'about', label: 'About' },
  { id: 'background', label: 'Background' },
  { id: 'stack', label: 'Stack' },
  { id: 'contact', label: 'Contact' },
];

const steps = 40;
const span = 200;
const center = 28;

const minorTicks = Array.from({ length: steps + 1 }, (_, index) => {
  const progress = index / steps;
  const major = index % 10 === 0;
  const mid = index % 5 === 0;
  return {
    y: center + progress * span,
    length: major ? 14 : mid ? 10 : 6,
    major,
  };
});
---

<nav class="scroll-dial" aria-label="Page sections">
  <div class="tuner-window">
    <svg class="tuner-strip" viewBox="0 0 120 256" data-strip aria-hidden="true">
      {
        minorTicks.map((tick) => (
          <line
            x1="8"
            y1={tick.y}
            x2={8 + tick.length}
            y2={tick.y}
            class:list={['tick', { 'tick-mid': !tick.major && tick.length === 10 }]}
          />
        ))
      }
      {
        sections.map((section) => (
          <g class="tick-major" data-section={section.id} role="button" tabindex="0" aria-label={`Go to ${section.label}`}>
            <rect class="tick-major-hit" x="4" y="-5" width="40" height="10" />
            <line class="tick-major-line" x1="8" y1="0" x2="26" y2="0" />
            <text class="tick-major-label" x="32" y="3">{section.label}</text>
          </g>
        ))
      }
    </svg>
    <span class="needle" aria-hidden="true"></span>
  </div>

  <button type="button" class="sound-toggle" data-sound aria-pressed="false" aria-label="Enable dial sounds">
    <span class="sound-icon" aria-hidden="true">
      <svg viewBox="0 0 16 16" class="sound-on-icon">
        <path d="M2 6h2.5L8 3v10L4.5 10H2z" />
        <path d="M10.5 5.5c1 .8 1 4.2 0 5" fill="none" stroke="currentColor" stroke-width="1.2" />
        <path d="M12.5 3.5c1.8 1.7 1.8 7.3 0 9" fill="none" stroke="currentColor" stroke-width="1.2" />
      </svg>
      <svg viewBox="0 0 16 16" class="sound-off-icon">
        <path d="M2 6h2.5L8 3v10L4.5 10H2z" />
        <path d="M10.5 6l4 4m0-4l-4 4" fill="none" stroke="currentColor" stroke-width="1.2" />
      </svg>
    </span>
    <span class="sound-text" data-sound-text>Sound off</span>
  </button>
</nav>

<style>
  .scroll-dial {
    position: fixed;
    left: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: none;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  @media (min-width: 1280px) {
    .scroll-dial {
      display: flex;
    }
  }

  .tuner-window {
    position: relative;
    width: 132px;
    height: 56px;
    overflow: hidden;
    border: 1px solid var(--color-stone-300);
    border-radius: 3px;
    background: var(--color-paper);
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.08);
  }

  .tuner-strip {
    position: absolute;
    inset: 0;
    width: 120px;
    height: 256px;
    will-change: transform;
  }

  .tick {
    stroke: var(--color-stone-300);
    stroke-width: 1;
  }

  .tick-mid {
    stroke: var(--color-stone-400);
  }

  .tick-major {
    cursor: pointer;
    outline: none;
  }

  .tick-major-hit {
    fill: transparent;
    stroke: none;
  }

  .tick-major-line {
    stroke: var(--color-stone-400);
    stroke-width: 1.6;
    transition: stroke 160ms ease, stroke-width 160ms ease;
  }

  .tick-major:hover .tick-major-line,
  .tick-major:focus-visible .tick-major-line {
    stroke: var(--color-accent);
    stroke-width: 2.2;
  }

  .tick-major-label {
    fill: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.02em;
  }

  .needle {
    position: absolute;
    left: 0;
    right: 0;
    top: 27px;
    height: 1px;
    background: var(--color-accent);
    pointer-events: none;
  }

  .needle::before {
    content: '';
    position: absolute;
    left: 0;
    top: -3px;
    border-top: 3.5px solid transparent;
    border-bottom: 3.5px solid transparent;
    border-left: 5px solid var(--color-accent);
  }

  .sound-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 6px;
    border: 1px solid var(--color-stone-200);
    border-radius: 4px;
    background: var(--color-paper);
    color: var(--color-stone-500);
    font-family: var(--font-mono);
    font-size: 9px;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .sound-toggle:hover,
  .sound-toggle[aria-pressed='true'] {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .sound-icon svg {
    width: 13px;
    height: 13px;
    fill: currentColor;
  }

  .sound-on-icon {
    display: none;
  }

  .sound-toggle[aria-pressed='true'] .sound-on-icon {
    display: block;
  }

  .sound-toggle[aria-pressed='true'] .sound-off-icon {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .tuner-strip {
      will-change: auto;
    }
  }
</style>

<script>
  const span = 200;
  const center = 28;

  const strip = document.querySelector<SVGSVGElement>('[data-strip]');
  const majors = [...document.querySelectorAll<SVGGElement>('.tick-major')];
  const toggle = document.querySelector<HTMLButtonElement>('[data-sound]');
  const soundText = document.querySelector<HTMLElement>('[data-sound-text]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let maxScroll = 1;
  let lastY = window.scrollY;
  let lastSection = -1;
  let majorFractions: number[] = [];
  let ticking = false;

  const updateMajorPositions = () => {
    majorFractions = [];
    for (const major of majors) {
      const element = document.getElementById(major.dataset.section ?? '');
      if (!element) continue;
      const fraction = maxScroll > 0 ? Math.min(1, Math.max(0, (element.getBoundingClientRect().top + window.scrollY) / maxScroll)) : 0;
      majorFractions.push(fraction);
      const y = center + fraction * span;
      const line = major.querySelector('line');
      const text = major.querySelector('text');
      const hit = major.querySelector('rect');
      line?.setAttribute('y1', String(y));
      line?.setAttribute('y2', String(y));
      text?.setAttribute('y', String(y + 3));
      hit?.setAttribute('y', String(y - 5));
    }
  };

  let audio: AudioContext | null = null;
  let master: GainNode | null = null;
  let noiseGain: GainNode | null = null;
  let clickBuffer: AudioBuffer | null = null;
  let noiseTimer = 0;
  let soundOn = false;

  const setupAudio = () => {
    if (audio) return;
    audio = new AudioContext();
    master = audio.createGain();
    master.gain.value = 0;
    master.connect(audio.destination);

    const scrollBuffer = audio.createBuffer(1, audio.sampleRate, audio.sampleRate);
    const scrollData = scrollBuffer.getChannelData(0);
    let brown = 0;
    for (let i = 0; i < scrollData.length; i += 1) {
      brown = (brown + 0.02 * (Math.random() * 2 - 1)) / 1.02;
      scrollData[i] = brown * 3.5;
    }

    const noise = audio.createBufferSource();
    noise.buffer = scrollBuffer;
    noise.loop = true;
    const filter = audio.createBiquadFilter();
    filter.type = 'lowpass';
    filter.frequency.value = 300;
    noiseGain = audio.createGain();
    noiseGain.gain.value = 0;
    noise.connect(filter).connect(noiseGain).connect(master);
    noise.start();

    clickBuffer = audio.createBuffer(1, Math.ceil(audio.sampleRate * 0.02), audio.sampleRate);
    const clickData = clickBuffer.getChannelData(0);
    for (let i = 0; i < clickData.length; i += 1) clickData[i] = Math.random() * 2 - 1;
  };

  const playTick = () => {
    if (!soundOn || !audio || !master || !clickBuffer) return;
    const now = audio.currentTime;

    const osc = audio.createOscillator();
    const toneGain = audio.createGain();
    osc.type = 'triangle';
    osc.frequency.value = 400 + Math.random() * 80;
    toneGain.gain.setValueAtTime(0.0001, now);
    toneGain.gain.exponentialRampToValueAtTime(0.028, now + 0.003);
    toneGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.028);
    osc.connect(toneGain).connect(master);
    osc.start(now);
    osc.stop(now + 0.03);

    const transient = audio.createBufferSource();
    transient.buffer = clickBuffer;
    const band = audio.createBiquadFilter();
    band.type = 'bandpass';
    band.frequency.value = 1500;
    band.Q.value = 1.2;
    const transientGain = audio.createGain();
    transientGain.gain.setValueAtTime(0.012, now);
    transientGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.012);
    transient.connect(band).connect(transientGain).connect(master);
    transient.start(now);
    transient.stop(now + 0.02);
  };

  const update = () => {
    maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
    updateMajorPositions();
    const progress = Math.min(1, Math.max(0, window.scrollY / maxScroll));
    strip?.style.setProperty('transform', `translateY(${-progress * span}px)`);

    const dy = Math.abs(window.scrollY - lastY);

    let sectionIndex = 0;
    for (let i = 0; i < majorFractions.length; i += 1) {
      if (progress >= majorFractions[i] - 0.002) sectionIndex = i;
    }
    if (sectionIndex !== lastSection) {
      if (lastSection !== -1 && dy !== 0) playTick();
      lastSection = sectionIndex;
    }

    if (soundOn && audio && noiseGain) {
      noiseGain.gain.setTargetAtTime(Math.min(0.012, dy / 12000), audio.currentTime, 0.03);
      clearTimeout(noiseTimer);
      noiseTimer = window.setTimeout(() => {
        if (audio && noiseGain) noiseGain.gain.setTargetAtTime(0, audio.currentTime, 0.06);
      }, 80);
    }

    lastY = window.scrollY;
    ticking = false;
  };

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    },
    { passive: true }
  );
  window.addEventListener('resize', () => {
    updateMajorPositions();
    update();
  });

  toggle?.addEventListener('click', async () => {
    soundOn = !soundOn;
    if (soundOn) {
      setupAudio();
      if (audio?.state === 'suspended') await audio.resume();
      master?.gain.setTargetAtTime(0.8, audio!.currentTime, 0.03);
      window.setTimeout(() => playTick(), 60);
    } else {
      if (audio && master) master.gain.setTargetAtTime(0, audio.currentTime, 0.03);
      if (noiseGain && audio) noiseGain.gain.setTargetAtTime(0, audio.currentTime, 0.03);
    }
    toggle.setAttribute('aria-pressed', String(soundOn));
    toggle.setAttribute('aria-label', soundOn ? 'Disable dial sounds' : 'Enable dial sounds');
    if (soundText) soundText.textContent = soundOn ? 'Sound on' : 'Sound off';
  });

  for (const major of majors) {
    const go = () => {
      document.getElementById(major.dataset.section ?? '')?.scrollIntoView({
        behavior: reduced ? 'auto' : 'smooth',
        block: 'start',
      });
    };
    major.addEventListener('click', go);
    major.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        go();
      }
    });
  }

  update();
</script>
