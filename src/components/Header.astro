---
import { site } from '../data/site';

const links = [
  { href: '#work', label: 'Work' },
  { href: '#about', label: 'About' },
  { href: '#background', label: 'Background' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 border-b border-stone-200/70 bg-paper/85 backdrop-blur-md">
  <nav
    aria-label="Primary"
    class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-4 text-sm sm:px-8"
  >
    <a href="#top" class="shrink-0 font-semibold tracking-tight text-ink hover:text-accent">
      {site.initials}<span class="ml-2 hidden font-normal text-stone-600 sm:inline"
        >{site.displayName}</span
      >
    </a>

    <div class="flex items-center gap-4 sm:gap-7">
      {
        links.map((link) => (
          <a href={link.href} class="text-stone-600 transition-colors hover:text-accent">
            {link.label}
          </a>
        ))
      }
      <a
        href={site.cv}
        class="hidden items-center gap-1 text-stone-600 transition-colors hover:text-accent sm:inline-flex"
      >
        CV <span aria-hidden="true">↗</span>
        <span class="sr-only">Download PDF</span>
      </a>
    </div>
  </nav>
</header>
