---
import Section from './Section.astro';
import { projects } from '../data/projects';

const featured = projects.filter((project) => project.featured);
const others = projects.filter((project) => !project.featured);
---

<Section id="work" index="01" title="Selected work" subtitle="Products & open source">
  <p
    class="mb-8 border-y border-stone-200 py-4 font-mono text-[11px] uppercase leading-relaxed tracking-wider text-stone-600"
  >
    Worked with <span class="text-ink">Marrket Africa · Billkit · CyberEx · Celebut · Cinfores · Prena Resources</span>
  </p>

  <div class="grid gap-4 sm:grid-cols-3">
    {
      featured.map((project, index) => (
        <a
          href={project.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col rounded-xl border border-stone-200 bg-white/60 p-5 transition duration-200 hover:-translate-y-0.5 hover:border-accent/50 hover:shadow-sm"
        >
          <div class="flex items-start justify-between gap-4">
            <span class="font-mono text-xs text-stone-600">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="text-stone-600 transition-colors group-hover:text-accent" aria-hidden="true">
              ↗
            </span>
            <span class="sr-only">Opens in a new tab</span>
          </div>

          <h3 class="mt-4 text-lg font-semibold tracking-tight text-ink">{project.title}</h3>
          <p class="mt-1 text-[11px] uppercase tracking-wider text-accent">{project.category}</p>
          {
            project.outcome && (
              <p class="mt-3 inline-flex w-fit rounded-full border border-accent/30 px-2.5 py-1 text-[11px] font-medium text-accent">
                {project.outcome}
              </p>
            )
          }
          <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-stone-600">
            {project.description}
          </p>

          <div class="mt-auto flex flex-wrap gap-1.5 pt-5">
            {project.tags.map((tag) => (
              <span class="rounded-full border border-stone-200 px-2.5 py-1 text-[11px] text-stone-500">
                {tag}
              </span>
            ))}
          </div>
        </a>
      ))
    }
  </div>

  <div class="mt-8">
    <h3 class="mb-2 font-mono text-[11px] uppercase tracking-wider text-stone-500">Also built</h3>
    <div class="border-y border-stone-200">
      {
        others.map((project) => (
          <a
            href={project.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-between gap-4 border-b border-stone-200 py-4 last:border-b-0"
          >
            <span class="min-w-0">
              <span class="font-medium text-ink transition-colors group-hover:text-accent">
                {project.title}
              </span>
              <span class="mt-0.5 block text-sm text-stone-600">{project.brief}</span>
              <span class="mt-2 flex flex-wrap gap-1.5">
                {
                  project.tags.map((tag) => (
                    <span class="rounded-full border border-stone-200 px-2 py-0.5 text-[10px] text-stone-500">
                      {tag}
                    </span>
                  ))
                }
              </span>
            </span>
            <span class="flex shrink-0 items-center gap-4">
              {project.outcome && (
                <span class="hidden font-mono text-[11px] text-accent sm:inline">
                  {project.outcome}
                </span>
              )}
              <span class="text-stone-500 transition-colors group-hover:text-accent" aria-hidden="true">
                ↗
              </span>
            </span>
            <span class="sr-only">Opens in a new tab</span>
          </a>
        ))
      }
    </div>
  </div>
</Section>
