---
import { site } from '../data/site';
---

<div id="top" class="scroll-mt-20">
  <span class="hero-cursor" data-cursor aria-hidden="true">
    <span class="hero-cursor-content" data-cursor-content></span>
  </span>
  <div class="mx-auto max-w-5xl px-5 pb-16 pt-20 sm:px-8 sm:pb-24 sm:pt-28">
    <p class="hero-in font-mono text-xs uppercase tracking-[0.18em] text-accent" style="--delay: 60ms">
      {site.role} · {site.location}
    </p>

    <h1
      class="hero-in mt-6 max-w-4xl font-display text-5xl font-normal leading-[1.05] tracking-tight text-ink sm:text-7xl lg:text-8xl"
      style="--delay: 140ms"
    >
      <span class="hero-name" data-name>{site.name}</span>
    </h1>

    <p
      class="hero-in mt-7 max-w-2xl text-lg leading-relaxed text-stone-600 sm:text-xl"
      style="--delay: 220ms"
    >
      {site.intro}
    </p>

    <div class="hero-in mt-9 flex flex-wrap items-center gap-3" style="--delay: 300ms">
      <a
        href="#work"
        class="inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-paper transition-colors hover:bg-accent"
      >
        See selected work <span aria-hidden="true">↓</span>
      </a>
      <a
        href={`mailto:${site.email}`}
        class="inline-flex items-center gap-2 rounded-full border border-stone-300 px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent"
      >
        Get in touch <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="hero-in mt-16 border-t border-stone-200 pt-6" style="--delay: 380ms">
      <a
        href="#contact"
        class="inline-flex items-center gap-2 rounded-full border border-stone-300 px-3 py-1.5 font-mono text-[11px] uppercase tracking-wider text-stone-600 transition-colors hover:border-accent hover:text-accent"
      >
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent/40"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
        </span>
        {site.availability}
      </a>
    </div>
  </div>
</div>

<style>
  .hero-name {
    display: inline-block;
  }

  .hero-cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    background: var(--color-paper);
    border: 1px solid var(--color-stone-200);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
    transform: translate(-50%, -50%) scale(0.4);
    transition:
      opacity 150ms ease,
      transform 180ms cubic-bezier(0.2, 0.7, 0.2, 1);
    will-change: left, top;
  }

  .hero-cursor.is-active {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .hero-cursor-content {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
    will-change: transform;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-name {
      cursor: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cursor {
      transition: none;
    }
  }
</style>

<script>
  const name = document.querySelector<HTMLElement>('[data-name]');
  const cursor = document.querySelector<HTMLElement>('[data-cursor]');
  const content = document.querySelector<HTMLElement>('[data-cursor-content]');

  if (name && cursor && content && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const zoom = 2;
    const lens = 96;
    let last: { x: number; y: number } | null = null;

    const update = (x: number, y: number) => {
      const rect = name.getBoundingClientRect();
      const style = getComputedStyle(name);

      content.textContent = name.textContent;
      content.style.width = `${rect.width}px`;
      content.style.fontFamily = style.fontFamily;
      content.style.fontSize = style.fontSize;
      content.style.fontWeight = style.fontWeight;
      content.style.fontStyle = style.fontStyle;
      content.style.letterSpacing = style.letterSpacing;
      content.style.lineHeight = style.lineHeight;
      content.style.color = style.color;
      content.style.transform = `translate(${lens / 2 - (x - rect.left) * zoom}px, ${lens / 2 - (y - rect.top) * zoom}px) scale(${zoom})`;

      cursor.style.left = `${x}px`;
      cursor.style.top = `${y}px`;
    };

    const move = (event: PointerEvent) => {
      last = { x: event.clientX, y: event.clientY };
      update(event.clientX, event.clientY);
      cursor.classList.add('is-active');
    };

    name.addEventListener('pointerenter', move);
    name.addEventListener('pointermove', move);
    name.addEventListener('pointerleave', () => {
      cursor.classList.remove('is-active');
      last = null;
    });
    window.addEventListener('scroll', () => {
      if (last) update(last.x, last.y);
    }, { passive: true });
    window.addEventListener('resize', () => {
      if (last) update(last.x, last.y);
    });
  }
</script>
