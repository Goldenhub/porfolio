---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — Chibueze Golden Azubuike" description="This page does not exist.">
  <main
    class="mx-auto flex min-h-screen max-w-5xl flex-col items-start justify-center px-5 sm:px-8"
  >
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent">404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
      Page not found.
    </h1>
    <p class="mt-4 text-sm text-stone-600">The page you're looking for doesn't exist.</p>
    <a
      href="/"
      class="mt-8 inline-flex rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-paper transition-colors hover:bg-accent"
    >
      Back to home
    </a>
  </main>
</Layout>
